        <Text x="64" y="34" width="900" height="40" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Title" id="1:101"><TextStylePaint fontSize="27" fontAssetId="1:1" name="S" id="1:102"><Fill name="F"><SolidColor colorValue="FFF2F6FB" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:102" text="How a filter turns an image into a feature map" name="R"/></Text>
        <Node x="114.26" y="664.00" name="TeacherRig" id="1:103"><NestedArtboard artboardId="2:1" x="-167.69" y="-233.69" scaleX="0.3367" scaleY="0.3367" name="TeacherArt" id="1:104"><NestedStateMachine animationId="2:2739" name="Idle"/></NestedArtboard></Node>
        <Node x="198.51020408163265" y="506" name="Bubble" id="1:126" opacity="0"><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap0" id="1:105" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:106"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:106" text="An image is just a grid of numbers - bright pixels are high, dark are low." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap1" id="1:107" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:108"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:108" text="A filter is a small grid of numbers too. This one has only nine." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap2" id="1:109" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:110"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:110" text="Lay it on the image. Multiply each pair, then add all nine results together." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap3" id="1:111" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:112"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:112" text="That one number says how strongly this patch matches the filter." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap4" id="1:113" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:114"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:114" text="Now slide one step and repeat - reusing the very same nine numbers." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap5" id="1:115" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:116"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:116" text="Read it backwards: every output cell came from the 3x3 patch beneath it." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap6" id="1:117" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:118"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:118" text="And forwards: one pixel feeds every output whose patch covered it." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap7" id="1:119" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:120"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:120" text="Change the nine numbers, and the filter looks for something else entirely." name="R"/></Text><Text x="26" y="19" width="604" height="18" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap8" id="1:121" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:122"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:122" text="Only nine positions fit, so the map comes out 3x3 - smaller than the image." name="R"/></Text><Shape x="2.0" y="28.0" rotation="-1.5707963" name="tailL" id="1:123" opacity="0"><Triangle originX="0.5" originY="0.5" width="22" height="15" name="P"/><Fill name="F"><SolidColor colorValue="FF141C2A" name="C"/></Fill></Shape><Shape x="654.0" y="28.0" rotation="1.5707963" name="tailR" id="1:124" opacity="0"><Triangle originX="0.5" originY="0.5" width="22" height="15" name="P"/><Fill name="F"><SolidColor colorValue="FF141C2A" name="C"/></Fill></Shape><Shape x="0" y="0" name="BubbleBg" id="1:125"><Rectangle originX="0" originY="0" width="656" height="56" cornerRadiusTL="16" name="P"/><Fill name="F"><SolidColor colorValue="FF141C2A" name="C"/></Fill></Shape></Node>
