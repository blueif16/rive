        <Text x="64" y="38" width="900" height="40" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Title" id="1:101"><TextStylePaint fontSize="27" fontAssetId="1:1" name="S" id="1:102"><Fill name="F"><SolidColor colorValue="FFF2F6FB" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:102" text="How a filter turns an image into a feature map" name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap0" id="1:103" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:104"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:104" text="An image is just a grid of numbers - bright pixels are high, dark are low." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap1" id="1:105" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:106"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:106" text="A filter is a small grid of numbers too. This one has only nine." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap2" id="1:107" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:108"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:108" text="Lay it on the image. Multiply each pair, then add all nine results together." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap3" id="1:109" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:110"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:110" text="That one number says how strongly this patch matches the filter." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap4" id="1:111" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:112"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:112" text="Now slide one step and repeat - reusing the very same nine numbers." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap5" id="1:113" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:114"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:114" text="Read it backwards: every output cell came from the 3x3 patch beneath it." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap6" id="1:115" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:116"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:116" text="And forwards: one pixel feeds every output whose patch covered it." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap7" id="1:117" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:118"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:118" text="Change the nine numbers, and the filter looks for something else entirely." name="R"/></Text>
        <Text x="64" y="84" width="1080" height="30" sizingValue="fixed" overflowValue="visible" alignValue="left" verticalAlignValue="middle" name="Cap8" id="1:119" opacity="0"><TextStylePaint fontSize="17" fontAssetId="1:1" name="S" id="1:120"><Fill name="F"><SolidColor colorValue="FF8A99AD" name="C"/></Fill></TextStylePaint><TextValueRun styleId="1:120" text="Only nine positions fit, so the map comes out 3x3 - smaller than the image." name="R"/></Text>
